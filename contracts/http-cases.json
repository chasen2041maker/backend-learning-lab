{
  "contract_version": 1,
  "id_format": "uuid-v4",
  "title_length_unit": "unicode_code_points",
  "create_cases": [
    {
      "name": "valid ascii",
      "authorization": true,
      "body": {"title": "Cannot sign in"},
      "expected_status": 201,
      "expected_code": "ok"
    },
    {
      "name": "valid unicode characters",
      "authorization": true,
      "repeat_title": {"text": "中", "count": 100},
      "expected_status": 201,
      "expected_code": "ok"
    },
    {
      "name": "padded 200 character title",
      "authorization": true,
      "repeat_title": {"text": "a", "count": 200, "prefix": " ", "suffix": " "},
      "expected_status": 201,
      "expected_code": "ok"
    },
    {
      "name": "numeric title",
      "authorization": true,
      "body": {"title": 123},
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "top level array",
      "authorization": true,
      "body": [],
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "empty body",
      "authorization": true,
      "raw_body": "",
      "expected_status": 400,
      "expected_code": "invalid_json"
    },
    {
      "name": "blank title",
      "authorization": true,
      "body": {"title": "   "},
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "unknown field",
      "authorization": true,
      "body": {"title": "Valid", "extra": true},
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "client tenant forgery",
      "authorization": true,
      "body": {"title": "Forged", "tenant_id": "tenant_b"},
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "malformed json",
      "authorization": true,
      "raw_body": "{\"title\":",
      "expected_status": 400,
      "expected_code": "invalid_json"
    },
    {
      "name": "trailing json",
      "authorization": true,
      "raw_body": "{\"title\":\"Valid\"}{\"second\":true}",
      "expected_status": 400,
      "expected_code": "invalid_json"
    },
    {
      "name": "missing authentication",
      "authorization": false,
      "body": {"title": "No auth"},
      "expected_status": 401,
      "expected_code": "authentication_required"
    }
  ],
  "health_cases": [
    {
      "name": "health without authentication",
      "authorization": false,
      "expected_status": 200,
      "expected_body": {"status": "ok"}
    }
  ],
  "get_cases": [
    {
      "name": "missing ticket",
      "authorization": true,
      "ticket_id": "00000000-0000-4000-8000-000000000001",
      "expected_status": 404,
      "expected_code": "ticket_not_found"
    },
    {
      "name": "cross tenant ticket is hidden",
      "authorization": true,
      "seed_title": "Private ticket",
      "seed_tenant": "tenant_a",
      "request_tenant": "tenant_b",
      "expected_status": 404,
      "expected_code": "ticket_not_found"
    },
    {
      "name": "invalid ticket id",
      "authorization": true,
      "ticket_id": "not-a-uuid",
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "uuid v1 ticket id",
      "authorization": true,
      "ticket_id": "6ba7b810-9dad-11d1-80b4-00c04fd430c8",
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "compact uuid ticket id",
      "authorization": true,
      "ticket_id": "00000000000040008000000000000001",
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    }
  ],
  "list_cases": [
    {
      "name": "newest first with limit",
      "authorization": true,
      "seed_titles": ["First", "Second"],
      "limit": 1,
      "expected_status": 200,
      "expected_code": "ok",
      "expected_titles": ["Second"]
    },
    {
      "name": "limit below minimum",
      "authorization": true,
      "limit": 0,
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    }
  ],
  "close_cases": [
    {
      "name": "missing ticket",
      "authorization": true,
      "ticket_id": "00000000-0000-4000-8000-000000000001",
      "expected_version": 1,
      "expected_status": 404,
      "expected_code": "ticket_not_found"
    },
    {
      "name": "invalid expected version",
      "authorization": true,
      "seed_title": "Close me",
      "expected_version": 0,
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "string expected version",
      "authorization": true,
      "seed_title": "Strict string version",
      "raw_body": "{\"expected_version\":\"1\"}",
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "float expected version",
      "authorization": true,
      "seed_title": "Strict float version",
      "raw_body": "{\"expected_version\":1.0}",
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "boolean expected version",
      "authorization": true,
      "seed_title": "Strict boolean version",
      "raw_body": "{\"expected_version\":true}",
      "expected_status": 422,
      "expected_code": "invalid_ticket_input"
    },
    {
      "name": "stale version",
      "authorization": true,
      "seed_title": "Versioned ticket",
      "expected_version": 99,
      "expected_status": 409,
      "expected_code": "ticket_version_conflict"
    },
    {
      "name": "duplicate close",
      "authorization": true,
      "seed_title": "Close once",
      "preclose_version": 1,
      "expected_version": 2,
      "expected_status": 409,
      "expected_code": "ticket_state_conflict"
    }
  ]
}
