{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/backend-learning-lab/event.schema.json",
  "title": "Backend Learning Lab Event Envelope v1",
  "$defs": {
    "ticketClosedV1Payload": {
      "type": "object",
      "required": ["ticket_id", "status", "version"],
      "properties": {
        "ticket_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "status": {"const": "closed"},
        "version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "tenant_id",
    "request_id",
    "trace_id",
    "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "minLength": 1},
    "event_version": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "request_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {"const": "ticket.closed"},
          "event_version": {"const": 1}
        },
        "required": ["event_type", "event_version"]
      },
      "then": {
        "properties": {
          "payload": {"$ref": "#/$defs/ticketClosedV1Payload"}
        }
      }
    }
  ]
}
